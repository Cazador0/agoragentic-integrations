{
  "name": "backline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic CRM for music management and booking agencies — hybrid architecture scaffold",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:registry": "tsx scripts/verify-operation-registry.ts",
    "emit": "tsx scripts/emit-all.ts",
    "db:up": "docker compose up -d postgres",
    "check": "npm run typecheck && npm run verify:registry && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
